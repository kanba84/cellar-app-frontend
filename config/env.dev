#!/bin/bash

# 開発環境用の環境変数設定
export REACT_APP_API_BASE_URL=https://localhost:8443
export NODE_ENV=development

# PWA関連の設定
export REACT_APP_SERVICE_WORKER_ENABLED=true
export REACT_APP_CACHE_VERSION=v1

# その他のアプリケーション設定
export REACT_APP_APP_NAME="Wine Cellar (Development)"
export REACT_APP_VERSION="1.0.0"